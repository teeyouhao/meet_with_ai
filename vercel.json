{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/api", "destination": "/api" },
    { "source": "/auth/(.*)", "destination": "/api" },
    { "source": "/auth", "destination": "/api" },
    { "source": "/((?!api|auth).*)", "destination": "/index.html" }
  ]
}
