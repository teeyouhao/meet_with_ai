{
  "version": 2,
  "buildCommand": "npm run build && npm --prefix server run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/auth/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|auth/).*)", "destination": "/index.html" }
  ]
}
